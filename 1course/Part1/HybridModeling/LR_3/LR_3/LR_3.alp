					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_MINUTE]]></Unit>
						</Rate>
						<Id>1794408118353</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1794470400000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// 1. Накапливаем время работы каждого исполнителя
mgr_load_sum = mgr_load_sum + mgr_active_curr;
sec_load_sum = sec_load_sum + sec_active_curr;
DB_load_sum = DB_load_sum + DB_active_curr;

// 2. Накапливаем суммы (добавляем текущее состояние к общей сумме)
mgr_load_sum = mgr_load_sum + mgr_active_curr;
mgr_queue_sum = mgr_queue_sum + mgr_queue_curr;

sec_load_sum = sec_load_sum + sec_active_curr;
sec_queue_sum = sec_queue_sum + sec_queue_curr;

DB_load_sum = DB_load_sum + DB_active_curr;
DB_queue_sum = DB_queue_sum + DB_queue_curr;

// 3. Считаем средние значения (делим накопленную сумму на текущее время моделирования)
// time() - это встроенная функция AnyLogic, возвращающая текущее время
if (time() > 0) {
    mgr_queue = mgr_queue_sum / time();       // Средняя очередь
    
    sec_queue = sec_queue_sum / time();
    
    DB_queue = DB_queue_sum / time();
}
// Берем среднее время из любого блока End (они все собирают данные от одного Start)
total_avg_time = timeMeasureEndSuccess.distribution.mean();]]></Action>
				</Event>
			</Events>
